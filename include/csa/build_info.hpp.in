// Generated by CMake (configure_file) from build_info.hpp.in at configure
// time -- not hand-written, not committed (see .gitignore). If this file
// is missing, re-run cmake; it is regenerated on every configure, so it
// always reflects the tree that was actually configured, not a stale
// commit hash left over from a previous checkout.
#pragma once

namespace csa {

// Short (7-char) commit hash of HEAD at configure time, or "unknown" if
// git wasn't available / this isn't a git checkout (e.g. a source
// tarball). Deliberately not the full 40-char hash -- reproducibility
// tracking needs "which commit," not cryptographic collision resistance.
constexpr const char* kGitCommit = "@CSA_GIT_COMMIT@";

// True if the working tree had uncommitted changes at configure time --
// a real, honest caveat for any benchmark run built from a dirty tree,
// since "commit abc1234" alone would otherwise imply a result is exactly
// reproducible from that commit alone when it might not be.
constexpr bool kGitDirty = @CSA_GIT_DIRTY@;

} // namespace csa
